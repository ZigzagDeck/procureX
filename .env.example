# ProcureX Configuration
# Copy to .env and fill in values

# LLM Provider
GOOGLE_API_KEY=

# Search API (optional - falls back to DuckDuckGo)
SERPAPI_KEY=your_serpapi_key_here

# x402 Fiat USD Configuration
X402_SIGNING_SECRET=your-secret-key-here   # REQUIRED in production
PROCUREX_X402_MODE=mock                     # set to 'live' for real payments
X402_PREPAID_BALANCE_USD=1.00              # initial account balance
PROCUREX_INTEL_SERVICE_URL=http://localhost:8000

# Budget Configuration
PROCUREX_INITIAL_BUDGET=0.020
PROCUREX_PRICE_INTEL_COST=0.002
PROCUREX_SUPPLIER_VERIFY_COST=0.001

# Geocoding (optional - defaults to Nominatim)
GOOGLE_MAPS_API_KEY=

# Cashfree Secure ID - GST Verification
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
GST_VERIFICATION_MODE=