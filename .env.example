# ProcureX Configuration
# Copy to .env and fill in values

# LLM Provider
GOOGLE_API_KEY=your_gemini_api_key_here

# Search API (optional - falls back to DuckDuckGo)
SERPAPI_KEY=your_serpapi_key_here

# x402 Configuration
PROCUREX_X402_MODE=mock
PROCUREX_WALLET_PRIVATE_KEY=
PROCUREX_X402_NETWORK=base-sepolia
PROCUREX_FACILITATOR_URL=

# Budget Configuration
PROCUREX_INITIAL_BUDGET=0.020
PROCUREX_PRICE_INTEL_COST=0.002
PROCUREX_SUPPLIER_VERIFY_COST=0.001

# Geocoding (optional - defaults to Nominatim)
GOOGLE_MAPS_API_KEY=
